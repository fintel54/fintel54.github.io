<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <title><%= title || 'CRUD App' %></title>
</head>
<body <% if (typeof bodyClass !== 'undefined') { %>class="<%= bodyClass %>"<% } %>>
<nav>
    <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/books">Books</a></li>
    </ul>
</nav>
<main>
    <h1>Books List</h1>

    <a href="/books/create">Create new</a>

    <ul class="index-list">
        <% books.forEach((book) => { %>
            <li>
                <h3><%= book.title %> - <%= book.author %></h3>
                <ul class="action-list">
                    <li><a href="/books/<%= book.id %>">Details</a></li>
                    <li><a href="/books/<%= book.id %>/edit">Edit</a></li>
                </ul>
            </li>
        <% }); %>
    </ul>
</main>
<footer>&copy;<%= new Date().getFullYear() %> CRUD App</footer>
</body>
</html>

